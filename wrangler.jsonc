{
  // Cloudflare Workers config for deploying CyberLab AI via the OpenNext adapter.
  // The app uses Node.js-runtime routes (e.g. node:crypto for the Paystack
  // webhook), so nodejs_compat is required. See docs/CLOUDFLARE_DEPLOY.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyberlab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
  // Set secrets with: wrangler secret put <NAME>
  //   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
  //   SUPABASE_SERVICE_ROLE_KEY, OPENROUTER_API_KEY,
  //   PAYSTACK_SECRET_KEY, PAYSTACK_PLAN_CODE,
  //   CYBERLAB_UNCENSORED_* , CYBERLAB_MCP_API_KEY
}
