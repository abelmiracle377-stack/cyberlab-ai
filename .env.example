# OpenRouter model access. Never commit a real key to this file or GitHub.
OPENROUTER_API_KEY=

# Supabase Auth (required to enable account sign-in and protected workspace routes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional authenticated read-only MCP gateway. Generate a long random secret before enabling.
CYBERLAB_MCP_API_KEY=

# Paystack recurring USD monthly plan. Keep secrets server-only.
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CODE=
SUPABASE_SERVICE_ROLE_KEY=
