# Cloud model access. Never commit a real key to this file or GitHub.
OPENROUTER_API_KEY=

# Optional Ollama endpoint reachable FROM THE CYBERLAB SERVER.
# For Vercel, 127.0.0.1 points to the Vercel function, not your personal computer.
# Use a secured private network/tunnel endpoint; do not expose Ollama publicly without authentication.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Supabase Auth (required to enable account sign-in and protected workspace routes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional authenticated read-only MCP gateway. Generate a long random secret before enabling.
CYBERLAB_MCP_API_KEY=

# Paystack recurring USD monthly plan. Keep secrets server-only.
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CODE=
# Leave unset or "false" for open access to all signed-in users. Set to "true" to enforce
# billing: new accounts get a 2-day trial, then an active subscription is required.
CYBERLAB_BILLING_ENFORCED=false
SUPABASE_SERVICE_ROLE_KEY=

# Hosted unfiltered/abliterated model provider. Server-only; never use NEXT_PUBLIC_.
CYBERLAB_UNCENSORED_API_KEY=
CYBERLAB_UNCENSORED_BASE_URL=
# JSON array: [{"id":"provider/model-id","name":"Display name","contextLength":32768}]
CYBERLAB_UNCENSORED_MODELS=

# Optional server-reachable Ollama endpoint. localhost refers to the CyberLab server.
OLLAMA_BASE_URL=

# Optional Windy public webcam catalogue integration. No private camera feeds are crawled.
WINDY_WEBCAMS_API_KEY=
